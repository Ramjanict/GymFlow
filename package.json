{
  "name": "gymflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @gymflow/api db:generate",
    "db:push": "pnpm --filter @gymflow/api db:push",
    "db:seed": "pnpm --filter @gymflow/api db:seed",
    "start:api": "pnpm --filter @gymflow/api start:dev",
    "start:web": "pnpm --filter @gymflow/web dev"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "bcryptjs"
    ]
  },
  "packageManager": "pnpm@12.21.0"
}
